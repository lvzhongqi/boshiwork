(* =====================================================================
   FILS Public Key authentication（ANA = 6）—— ProVerif 模型
   依据 IEEE Std 802.11-2024：
     §12.11.1            FILS 安全假设与目标
     §12.11.2.2          发现与公钥可信
     §12.11.2.4.2~.5     Authentication 帧（Seq=1 / Seq=2）
     §12.11.2.5.2/.3     PMK / PMKID / PTK 推导
     §12.11.2.6.2/.3     (Re)Association Request / Response 密钥确认
     §12.11.2.7          AEAD（AES-SIV）

   与 Visio「FILS PK 基于公钥的认证」面板的对应：
     M1 = Auth(Seq=1, AAN=6, DHGroup, gSTA, [PMKIDList], SNonce, Session, RSNE)
     M2 = Auth(Seq=2, Status, DHGroup, gAP, [PMKID], ANonce, Session, RSNE)
     M3 = (Re)Assoc Request (Session, RSNE, AEAD(PTK-KEK, PK_STA||KeyAuth_STA))
     M4 = (Re)Assoc Response(Session, Status, AEAD(PTK-KEK, PK_AP||KeyAuth_AP||GTK))

   相对 Visio 图按标准做的修正（详见报告）：
     1) 图中未画 RSNE 的携带与一致性校验；标准要求 Authentication 与
        (Re)Association 中的 RSNE 的 AKM/cipher/RSN 能力必须一致
        （§12.11.2.6.2/§12.11.2.6.3），本模型把 RSNE 纳入消息并纳入 AAD。
     2) 图中 PMKID 写作 Hash(gSTA||gAP)，标准为 Truncate-128(Hash(...))。
     3) 图中「PTK 上下文是否含 DHss」的方括号条件需按标准区分：
        无缓存 PK 的 DHss 已混入 PMK，PTK 上下文不含 DHss；
        使用 PMKSA caching 时 PMK 来自缓存，PTK 上下文才含 DHss。
     4) 图中把 AEAD 写成 AEAD-Dec(KEK, AAD, CT)，表明 AAD 参与解密校验；
        本模型用「解密必须提供相同 AAD」的 reduction 精确刻画。

   建模抽象与假设：
     - DH：exp(exp(g,x),y)=exp(exp(g,y),x)，仅建模被动安全的固定群；
     - 签名：sign/checksign + 可信公钥集合（证书链校验被抽象为公钥白名单）；
     - AEAD：aead((AAD,plaintext),KEK)，解密必须提供相同 AAD，否则不归约；
     - KDF：kdf(key,label,context) 为公开单向函数，不同 label 得到独立密钥；
     - GTK：作为 Key Delivery 中的私有不变量，用于检验 KEK/PTK 机密性；
     - 失败路径：AEAD 校验失败等同于进程停止（标准回 Status 112 并终止），
       本模型不额外输出失败帧，不影响保密性与一致性结论。
   ===================================================================== *)

(* ---------------------------------------------------------------------
   本文件与输出文件 FILS_PK.out.txt 的对应关系（验证结论：17 条查询全部 true）
     机密性（探针法：下列 free ... [private] 变量只会在攻击者求出相应密钥时被推出）：
       - not attacker(gtk_val)   true  → GTK 保密 ⇒ 承载它的 KEK 保密 ⇒ PTK/PMK 保密
       - not attacker(probe_tk)  true  → 受 TK 保护的数据帧明文不可得 ⇒ TK 保密
       - not attacker(pmk_c1)    true  → 预置 PMKSA 缓存条目 pmk_c1 保密
       - not attacker(pmk_c2)    true  → 预置 PMKSA 缓存条目 pmk_c2 保密
     认证 / 密钥确认 / 新鲜性（F = 无缓存 PK 分支；C = PMKSA 缓存分支）：
       - StaFinishF ==> ApFinishF（含 inj 版本）true
       - ApFinishF  ==> StaStartF （含 inj 版本）true
       - StaFinishC ==> ApFinishC（含 inj 版本）true
       - ApFinishC  ==> StaStartC （含 inj 版本）true
     新增目标（本轮扩展，均包含在 17 条查询中）：
       - StaPTKF ==> ApPTKF、StaPTKC ==> ApPTKC（PTK 一致性 + UKS 身份绑定）true
       - 同一 PTK 只属于同一会话（F/C 各一条唯一性查询）true
       - CacheUse ==> CacheStore（缓存一致性）true
   输出文件中没有攻击轨迹：既无 “Derivation:”，也无 “A trace has been found.”。
   --------------------------------------------------------------------- *)

free c:channel.

(* ---------------- 公开身份与常量 ---------------- *)
const sta1:bitstring.
const sta2:bitstring.
const ap1:bitstring.
const ap2:bitstring.

const g:bitstring.
const aan6:bitstring.
const seq1:bitstring.
const seq2:bitstring.
const st_ok:bitstring.
const st_77:bitstring.
const st_53:bitstring.
const st_112:bitstring.
const dhgrp:bitstring.
const rsne_pk:bitstring.
const none:bitstring.

const label_ptk:bitstring.
const label_ick:bitstring.
const label_kek:bitstring.
const label_tk:bitstring.
const label_data:bitstring.

(* PMKSA 缓存条目：由更早一次成功会话建立，分别只有 STA 与 AP 知道 *)
free pmk_c1:bitstring [private].
free pmk_c2:bitstring [private].
const pmkid_c1:bitstring.
const pmkid_c2:bitstring.

(* 机密性探针：GTK 与「关联后第一条受 TK 保护的数据帧」的明文 *)
free gtk_val:bitstring [private].
free probe_tk:bitstring [private].

(* ---------------- 密码学原语 ---------------- *)
fun exp(bitstring,bitstring):bitstring.
equation forall x:bitstring, y:bitstring;
  exp(exp(g,x),y) = exp(exp(g,y),x).

fun h(bitstring):bitstring.
fun trunc128(bitstring):bitstring.
fun some(bitstring):bitstring.
fun hmac(bitstring,bitstring):bitstring.
fun kdf(bitstring,bitstring,bitstring):bitstring.

fun pk(bitstring):bitstring.
fun sign(bitstring,bitstring):bitstring.
reduc forall m:bitstring, sk:bitstring;
  checksign(sign(m,sk), pk(sk)) = m.

(* AEAD：解密时必须提供与加密时相同的 AAD *)
fun aead(bitstring,bitstring):bitstring.
reduc forall a:bitstring, p:bitstring, k:bitstring;
  adec(aead((a,p),k), a, k) = p.

(* ---------------- 事件 ---------------- *)
event StaStartF(bitstring,bitstring,bitstring).
event ApFinishF(bitstring,bitstring,bitstring).
event StaFinishF(bitstring,bitstring,bitstring).

event StaStartC(bitstring,bitstring,bitstring).
event ApFinishC(bitstring,bitstring,bitstring).
event StaFinishC(bitstring,bitstring,bitstring).

(* 新增目标用事件：携带 PTK，支持一致性/唯一性/UKS 查询 *)
event StaPTKF(bitstring,bitstring,bitstring,bitstring).
event ApPTKF(bitstring,bitstring,bitstring,bitstring).
event StaPTKC(bitstring,bitstring,bitstring,bitstring).
event ApPTKC(bitstring,bitstring,bitstring,bitstring).

(* 新增目标用事件：缓存一致性（存储 / 使用） *)
event CacheStore(bitstring,bitstring,bitstring).
event CacheUse(bitstring,bitstring,bitstring).

(* =====================================================================
   安全目标（SG）与查询
   SG1  PMK / PTK / TK / GTK 机密性
        - 直接检验：GTK（KEK 保护）与 TK（数据帧保护）不可被攻击者得到；
        - 由 KDF 为公开确定性函数：攻击者若得到 PMK 即可算出 PTK/TK，
          故 TK 机密 ⇒ PTK 机密 ⇒ PMK 机密（逆否）。
   SG2  双向认证与密钥确认（对应关系）
   SG3  新鲜性 / 抗重放（injective agreement）
   SG4  PMKSA 缓存机密性
   ===================================================================== *)

(* --- 机密性 --- *)
query attacker(gtk_val).
query attacker(probe_tk).
query attacker(pmk_c1).
query attacker(pmk_c2).

(* --- 新鲜分支：双向对应 + 单射 --- *)
query s:bitstring, a:bitstring, se:bitstring;
  event(StaFinishF(s,a,se)) ==> event(ApFinishF(s,a,se)).

query s:bitstring, a:bitstring, se:bitstring;
  inj-event(StaFinishF(s,a,se)) ==> inj-event(ApFinishF(s,a,se)).

query s:bitstring, a:bitstring, se:bitstring;
  event(ApFinishF(s,a,se)) ==> event(StaStartF(s,a,se)).

query s:bitstring, a:bitstring, se:bitstring;
  inj-event(ApFinishF(s,a,se)) ==> inj-event(StaStartF(s,a,se)).

(* --- 缓存分支：双向对应 + 单射 --- *)
query s:bitstring, a:bitstring, se:bitstring;
  event(StaFinishC(s,a,se)) ==> event(ApFinishC(s,a,se)).

query s:bitstring, a:bitstring, se:bitstring;
  inj-event(StaFinishC(s,a,se)) ==> inj-event(ApFinishC(s,a,se)).

query s:bitstring, a:bitstring, se:bitstring;
  event(ApFinishC(s,a,se)) ==> event(StaStartC(s,a,se)).

query s:bitstring, a:bitstring, se:bitstring;
  inj-event(ApFinishC(s,a,se)) ==> inj-event(StaStartC(s,a,se)).

(* --- SG5 PTK 一致性（同时覆盖 UKS：身份 s,a 必须一致） --- *)
query s:bitstring, a:bitstring, se:bitstring, k:bitstring;
  event(StaPTKF(s,a,se,k)) ==> event(ApPTKF(s,a,se,k)).
query s:bitstring, a:bitstring, se:bitstring, k:bitstring;
  event(StaPTKC(s,a,se,k)) ==> event(ApPTKC(s,a,se,k)).

(* --- SG6 PTK 唯一性：同一 PTK 不得出现在不同会话 --- *)
query s1:bitstring, a1:bitstring, se1:bitstring,
      s2:bitstring, a2:bitstring, se2:bitstring, k:bitstring;
  event(StaPTKF(s1,a1,se1,k)) && event(StaPTKF(s2,a2,se2,k)) ==> se1 = se2.
query s1:bitstring, a1:bitstring, se1:bitstring,
      s2:bitstring, a2:bitstring, se2:bitstring, k:bitstring;
  event(StaPTKC(s1,a1,se1,k)) && event(StaPTKC(s2,a2,se2,k)) ==> se1 = se2.

(* --- SG7 缓存一致性：使用缓存条目必须此前存储过 --- *)
query s:bitstring, a:bitstring, p:bitstring;
  event(CacheUse(s,a,p)) ==> event(CacheStore(s,a,p)).

(* =====================================================================
   STA：无缓存公钥认证（每次均重新协商 PMK）
   ===================================================================== *)
let sta_pk_fresh(sta:bitstring, ap:bitstring, skS:bitstring, pkA:bitstring) =
  new sn:bitstring;
  new sS:bitstring;
  let gs = exp(g,sS) in
  new sess:bitstring;

  (* --- M1: Auth Seq=1 --- *)
  out(c, (sta, ap, aan6, seq1, dhgrp, gs, sn, sess, rsne_pk, none));

  (* --- M2: Auth Seq=2 --- *)
  in(c, (apR:bitstring, staR:bitstring, aanR:bitstring, seqR:bitstring,
         stR:bitstring, dhR:bitstring, gaR:bitstring, snR:bitstring,
         sessR:bitstring, rsneR:bitstring, anR:bitstring, pidR:bitstring));
  if apR = ap then
  if staR = sta then
  if aanR = aan6 then
  if seqR = seq2 then
  if stR = st_ok then
  if dhR = dhgrp then
  if snR = sn then
  if sessR = sess then
  if rsneR = rsne_pk then
  if pidR = none then

    (* --- 密钥推导：PMK = HMAC(SNonce||ANonce, DHss) --- *)
    let dhss = exp(gaR, sS) in
    let pmk = hmac((sn, anR), dhss) in
    (* 无缓存：PTK 上下文不含 DHss（DHss 已混入 PMK） *)
    let ptk = kdf(pmk, label_ptk, (sta, ap, sn, anR)) in
    let ick = kdf(ptk, label_ick, none) in
    let kek = kdf(ptk, label_kek, none) in
    let tk  = kdf(ptk, label_tk, none) in

    (* --- M3: KeyAuth = Sig-STA(gSTA||gAP||SNonce||ANonce||STA-MAC||AP-BSSID) --- *)
    let ka = sign((gs, gaR, sn, anR, sta, ap), skS) in
    let aad = (sta, ap, sn, anR, sess, rsne_pk) in
    let ct = aead((aad, (pk(skS), ka)), kek) in
    event StaStartF(sta, ap, sess);
    out(c, (sta, ap, sess, rsne_pk, ct));

    (* --- M4: Assoc Response --- *)
    in(c, (ap2R:bitstring, sta2R:bitstring, sess2R:bitstring,
           st2R:bitstring, rsne2R:bitstring, ct2R:bitstring));
    if ap2R = ap then
    if sta2R = sta then
    if sess2R = sess then
    if st2R = st_ok then
    if rsne2R = rsne_pk then

      let aad2 = (ap, sta, anR, sn, sess, rsne_pk) in
      let pl2 = adec(ct2R, aad2, kek) in
      let (pkAR:bitstring, rest2:bitstring) = pl2 in
      let (kaAR:bitstring, gtkR:bitstring) = rest2 in
      if pkAR = pkA then
      if checksign(kaAR, pkA) = (gaR, gs, anR, sn, ap, sta) then
        event StaFinishF(sta, ap, sess);
        event StaPTKF(sta, ap, sess, ptk);
        (* 关联后第一条受 TK 保护的数据帧（机密性探针） *)
        out(c, aead((label_data, probe_tk), tk)).

(* =====================================================================
   AP：无缓存公钥认证
   ===================================================================== *)
let ap_pk_fresh(ap:bitstring, sta:bitstring, skA:bitstring, pkS:bitstring) =
  (* --- M1 --- *)
  in(c, (staR:bitstring, apR:bitstring, aanR:bitstring, seqR:bitstring,
         dhR:bitstring, gsR:bitstring, snR:bitstring, sessR:bitstring,
         rsneR:bitstring, pidR:bitstring));
  if apR = ap then
  if staR = sta then
  if aanR = aan6 then
  if seqR = seq1 then
  if dhR = dhgrp then
  if pidR = none then

    new an:bitstring;
    new sA:bitstring;
    let ga = exp(g,sA) in
    let dhss = exp(gsR, sA) in
    let pmk = hmac((snR, an), dhss) in
    let ptk = kdf(pmk, label_ptk, (sta, ap, snR, an)) in
    let ick = kdf(ptk, label_ick, none) in
    let kek = kdf(ptk, label_kek, none) in
    let tk  = kdf(ptk, label_tk, none) in

    (* --- M2 --- *)
    out(c, (ap, sta, aan6, seq2, st_ok, dhgrp, ga, snR, sessR, rsneR, an, none));

    (* --- M3 --- *)
    in(c, (sta2R:bitstring, ap2R:bitstring, sess2R:bitstring,
           rsne3R:bitstring, ctR:bitstring));
    if sta2R = sta then
    if ap2R = ap then
    if sess2R = sessR then
    (* 标准 §12.11.2.6.2：Association 帧中的 RSNE 必须与 Auth 帧一致 *)
    if rsne3R = rsneR then

      let aad = (sta, ap, snR, an, sessR, rsne3R) in
      let pl = adec(ctR, aad, kek) in
      let (pkSR:bitstring, kaR:bitstring) = pl in
      if pkSR = pkS then
      if checksign(kaR, pkS) = (gsR, ga, snR, an, sta, ap) then
        event ApFinishF(sta, ap, sessR);
        event ApPTKF(sta, ap, sessR, ptk);

        (* --- M4: KeyAuth = Sig-AP(gAP||gSTA||ANonce||SNonce||AP-BSSID||STA-MAC) --- *)
        let kaap = sign((ga, gsR, an, snR, ap, sta), skA) in
        let aad2 = (ap, sta, an, snR, sessR, rsneR) in
        let ct2 = aead((aad2, (pk(skA), (kaap, gtk_val))), kek) in
        out(c, (ap, sta, sessR, st_ok, rsneR, ct2)).

(* =====================================================================
   STA：PMKSA 缓存分支（公钥认证 + 缓存 PMK）
   ===================================================================== *)
let sta_pk_cache(sta:bitstring, ap:bitstring, skS:bitstring, pkA:bitstring,
                 pmk:bitstring, pmkid:bitstring) =
  new sn:bitstring;
  new sS:bitstring;
  let gs = exp(g,sS) in
  new sess:bitstring;

  out(c, (sta, ap, aan6, seq1, dhgrp, gs, sn, sess, rsne_pk, some(pmkid)));

  in(c, (apR:bitstring, staR:bitstring, aanR:bitstring, seqR:bitstring,
         stR:bitstring, dhR:bitstring, gaR:bitstring, snR:bitstring,
         sessR:bitstring, rsneR:bitstring, anR:bitstring, pidR:bitstring));
  if apR = ap then
  if staR = sta then
  if aanR = aan6 then
  if seqR = seq2 then
  if stR = st_ok then
  if dhR = dhgrp then
  if snR = sn then
  if sessR = sess then
  if rsneR = rsne_pk then
  if pidR = some(pmkid) then

    let dhss = exp(gaR, sS) in
    (* 缓存分支：PMK 来自缓存，PTK 上下文含 DHss（标准方括号规则） *)
    let ptk = kdf(pmk, label_ptk, (sta, ap, sn, anR, dhss)) in
    let ick = kdf(ptk, label_ick, none) in
    let kek = kdf(ptk, label_kek, none) in
    let tk  = kdf(ptk, label_tk, none) in

    (* 缓存分支使用 ICK 的 HMAC 充当 KeyAuth *)
    let ka = hmac(ick, (sn, anR, sta, ap, gs, gaR)) in
    let aad = (sta, ap, sn, anR, sess, rsne_pk) in
    let ct = aead((aad, (pk(skS), ka)), kek) in
    event StaStartC(sta, ap, sess);
    out(c, (sta, ap, sess, rsne_pk, ct));

    in(c, (ap2R:bitstring, sta2R:bitstring, sess2R:bitstring,
           st2R:bitstring, rsne2R:bitstring, ct2R:bitstring));
    if ap2R = ap then
    if sta2R = sta then
    if sess2R = sess then
    if st2R = st_ok then
    if rsne2R = rsne_pk then

      let aad2 = (ap, sta, anR, sn, sess, rsne_pk) in
      let pl2 = adec(ct2R, aad2, kek) in
      let (pkAR:bitstring, rest2:bitstring) = pl2 in
      let (kaAR:bitstring, gtkR:bitstring) = rest2 in
      if pkAR = pkA then
      if kaAR = hmac(ick, (anR, sn, ap, sta, gaR, gs)) then
        event StaFinishC(sta, ap, sess);
        event StaPTKC(sta, ap, sess, ptk);
        event CacheUse(sta, ap, pmkid);
        out(c, aead((label_data, probe_tk), tk)).

(* =====================================================================
   AP：PMKSA 缓存分支
   ===================================================================== *)
let ap_pk_cache(ap:bitstring, sta:bitstring, skA:bitstring, pkS:bitstring,
                pmk:bitstring, pmkid:bitstring) =
  in(c, (staR:bitstring, apR:bitstring, aanR:bitstring, seqR:bitstring,
         dhR:bitstring, gsR:bitstring, snR:bitstring, sessR:bitstring,
         rsneR:bitstring, pidR:bitstring));
  if apR = ap then
  if staR = sta then
  if aanR = aan6 then
  if seqR = seq1 then
  if dhR = dhgrp then
  if pidR = some(pmkid) then

    new an:bitstring;
    new sA:bitstring;
    let ga = exp(g,sA) in
    let dhss = exp(gsR, sA) in
    let ptk = kdf(pmk, label_ptk, (sta, ap, snR, an, dhss)) in
    let ick = kdf(ptk, label_ick, none) in
    let kek = kdf(ptk, label_kek, none) in
    let tk  = kdf(ptk, label_tk, none) in

    out(c, (ap, sta, aan6, seq2, st_ok, dhgrp, ga, snR, sessR, rsneR, an,
            some(pmkid)));

    in(c, (sta2R:bitstring, ap2R:bitstring, sess2R:bitstring,
           rsne3R:bitstring, ctR:bitstring));
    if sta2R = sta then
    if ap2R = ap then
    if sess2R = sessR then
    if rsne3R = rsneR then

      let aad = (sta, ap, snR, an, sessR, rsne3R) in
      let pl = adec(ctR, aad, kek) in
      let (pkSR:bitstring, kaR:bitstring) = pl in
      if pkSR = pkS then
      if kaR = hmac(ick, (snR, an, sta, ap, gsR, ga)) then
        event ApFinishC(sta, ap, sessR);
        event ApPTKC(sta, ap, sessR, ptk);

        let kaap = hmac(ick, (an, snR, ap, sta, ga, gsR)) in
        let aad2 = (ap, sta, an, snR, sessR, rsneR) in
        let ct2 = aead((aad2, (pk(skA), (kaap, gtk_val))), kek) in
        out(c, (ap, sta, sessR, st_ok, rsneR, ct2)).

(* =====================================================================
   顶层进程
   - 两个 STA-AP 对；
   - 无缓存分支可以无界重复（用于单射一致性/抗重放）；
   - 缓存分支使用预置 PMKSA（分别只有 STA 与 AP 持有）。
   ===================================================================== *)
process
  new skS1:bitstring;
  new skS2:bitstring;
  new skA1:bitstring;
  new skA2:bitstring;
  let pkS1 = pk(skS1) in
  let pkS2 = pk(skS2) in
  let pkA1 = pk(skA1) in
  let pkA2 = pk(skA2) in

  (* 长期公钥公开：把“证书/公钥可信分发”抽象为直接公开公钥 *)
  out(c, pkS1);
  out(c, pkS2);
  out(c, pkA1);
  out(c, pkA2);

  (* 模拟“更早一次成功会话已把两个 PMKSA 存入缓存”（缓存一致性目标用） *)
  event CacheStore(sta1, ap1, pmkid_c1);
  event CacheStore(sta2, ap2, pmkid_c2);

  (* F 分支无界复制；C 分支使用预置 PMKSA 且只跑一次 *)
  (
    ( !sta_pk_fresh(sta1, ap1, skS1, pkA1) )
    |
    ( !ap_pk_fresh(ap1, sta1, skA1, pkS1) )
    |
    ( !sta_pk_fresh(sta2, ap2, skS2, pkA2) )
    |
    ( !ap_pk_fresh(ap2, sta2, skA2, pkS2) )
    |
    (* C 分支：使用预置 PMKSA 缓存，PMKID 必须命中；只跑一次 *)
    ( sta_pk_cache(sta1, ap1, skS1, pkA1, pmk_c1, pmkid_c1)
      |
      ap_pk_cache(ap1, sta1, skA1, pkS1, pmk_c1, pmkid_c1) )
    |
    ( sta_pk_cache(sta2, ap2, skS2, pkA2, pmk_c2, pmkid_c2)
      |
      ap_pk_cache(ap2, sta2, skA2, pkS2, pmk_c2, pmkid_c2) )
  )
