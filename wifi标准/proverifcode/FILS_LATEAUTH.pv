(* =====================================================================
   FILS 风格的“先密钥协商、后在密钥确认中认证身份”（正确绑定）
   目的：单独验证这种消息顺序本身是否合理，而不是验证完整 FILS。
   协议（与 FILS PK 同构，去掉无关字段）：
     M1 STA -> AP : gs, SNonce, Session
     M2 AP  -> STA: ga, ANonce, Session
     双方计算 PTK = KDF(HMAC(SNonce||ANonce, DHss), ...)
     M3 STA -> AP : AEAD(PTK-KEK, Sig_STA(gs||ga||SNonce||ANonce||STA||AP||Session))
     M4 AP  -> STA: AEAD(PTK-KEK, Sig_AP(ga||gs||ANonce||SNonce||AP||STA||Session))
   安全要点：
     - DH 本身不认证任何身份（前两帧可被中间人替换）；
     - 身份认证 + 密钥确认放在 M3/M4，且签名覆盖完整 transcript；
     - AEAD 用派生出的 PTK-KEK，只有持有同一 DHss 的一方能解开；
     - 双方都验证对方 KeyAuth 后才算完成。
   结论（预期）：全部 true。
        这条顺序是合理的：它把“密钥建立”和“身份认证/密钥确认”
        合并到最后两帧，等价于 TLS 1.3 / SIGMA 的延迟认证模式。
   ===================================================================== *)

free c:channel.

const sta:bitstring.
const ap:bitstring.

const g:bitstring.
const label_ptk:bitstring.
const label_ick:bitstring.
const label_kek:bitstring.
const label_tk:bitstring.
const label_data:bitstring.
const none:bitstring.
const gtk_fake:bitstring.
const dh_valid:bitstring.

free probe_tk:bitstring [private].

fun exp(bitstring,bitstring):bitstring.
equation forall x:bitstring, y:bitstring;
  exp(exp(g,x),y) = exp(exp(g,y),x).

(* 临时 DH 公钥合法性校验，排除 gAP = g 之类的退化值 *)
reduc forall x:bitstring; dh_ok(exp(g,x)) = dh_valid.

fun hmac(bitstring,bitstring):bitstring.
fun kdf(bitstring,bitstring,bitstring):bitstring.
fun pk(bitstring):bitstring.
fun sign(bitstring,bitstring):bitstring.
reduc forall m:bitstring, sk:bitstring;
  checksign(sign(m,sk), pk(sk)) = m.
fun aead(bitstring,bitstring):bitstring.
reduc forall a:bitstring, p:bitstring, k:bitstring;
  adec(aead((a,p),k), a, k) = p.

event StaStart(bitstring,bitstring,bitstring).
event ApFinish(bitstring,bitstring,bitstring).
event StaFinish(bitstring,bitstring,bitstring).
event StaPTK(bitstring,bitstring,bitstring,bitstring).
event ApPTK(bitstring,bitstring,bitstring,bitstring).

query attacker(probe_tk).
query s:bitstring, a:bitstring, se:bitstring;
  event(StaFinish(s,a,se)) ==> event(ApFinish(s,a,se)).
query s:bitstring, a:bitstring, se:bitstring;
  inj-event(StaFinish(s,a,se)) ==> inj-event(ApFinish(s,a,se)).
query s:bitstring, a:bitstring, se:bitstring;
  event(ApFinish(s,a,se)) ==> event(StaStart(s,a,se)).
query s:bitstring, a:bitstring, se:bitstring;
  inj-event(ApFinish(s,a,se)) ==> inj-event(StaStart(s,a,se)).
query s:bitstring, a:bitstring, se:bitstring, k:bitstring;
  event(StaPTK(s,a,se,k)) ==> event(ApPTK(s,a,se,k)).
query s1:bitstring, a1:bitstring, se1:bitstring,
      s2:bitstring, a2:bitstring, se2:bitstring, k:bitstring;
  event(StaPTK(s1,a1,se1,k)) && event(StaPTK(s2,a2,se2,k)) ==> se1 = se2.

(* ---------------- STA ---------------- *)
let sta_proc(sta:bitstring, ap:bitstring, skS:bitstring, pkA:bitstring) =
  new sn:bitstring;
  new sS:bitstring;
  let gs = exp(g,sS) in
  new sess:bitstring;

  (* M1：只发临时 DH 公钥与 nonce，不做身份认证 *)
  out(c, (sta, ap, gs, sn, sess));

  (* M2 *)
  in(c, (apR:bitstring, staR:bitstring, gaR:bitstring,
         snR:bitstring, sessR:bitstring, anR:bitstring));
  if apR = ap then
  if staR = sta then
  if snR = sn then
  if sessR = sess then
  if dh_ok(gaR) = dh_valid then

    let dhss = exp(gaR, sS) in
    let pmk = hmac((sn, anR), dhss) in
    let ptk = kdf(pmk, label_ptk, (sta, ap, sn, anR, sess)) in
    let ick = kdf(ptk, label_ick, none) in
    let kek = kdf(ptk, label_kek, none) in
    let tk  = kdf(ptk, label_tk, none) in

    (* M3：身份认证 + 密钥确认；签名覆盖完整 transcript *)
    let ka = sign((gs, gaR, sn, anR, sta, ap, sess), skS) in
    let aad = (sta, ap, sn, anR, sess) in
    let ct = aead((aad, ka), kek) in
    event StaStart(sta, ap, sess);
    out(c, (sta, ap, sess, ct));

    (* M4：验证 AP 的 KeyAuth，成功后才认为认证完成 *)
    in(c, (ap2R:bitstring, sta2R:bitstring, sess2R:bitstring, ct2R:bitstring));
    if ap2R = ap then
    if sta2R = sta then
    if sess2R = sess then
      let aad2 = (ap, sta, anR, sn, sess) in
      let pl2 = adec(ct2R, aad2, kek) in
      let kaAR:bitstring = pl2 in
      if checksign(kaAR, pkA) = (gaR, gs, anR, sn, ap, sta, sess) then
        event StaFinish(sta, ap, sess);
        event StaPTK(sta, ap, sess, ptk);
        out(c, aead((label_data, probe_tk), tk)).

(* ---------------- AP ---------------- *)
let ap_proc(ap:bitstring, sta:bitstring, skA:bitstring, pkS:bitstring) =
  (* M1：此时 AP 还不知道对端是谁 *)
  in(c, (staR:bitstring, apR:bitstring, gsR:bitstring,
         snR:bitstring, sessR:bitstring));
  if apR = ap then
  if staR = sta then
  if dh_ok(gsR) = dh_valid then

    new an:bitstring;
    new sA:bitstring;
    let ga = exp(g,sA) in
    let dhss = exp(gsR, sA) in
    let pmk = hmac((snR, an), dhss) in
    let ptk = kdf(pmk, label_ptk, (sta, ap, snR, an, sessR)) in
    let ick = kdf(ptk, label_ick, none) in
    let kek = kdf(ptk, label_kek, none) in
    let tk  = kdf(ptk, label_tk, none) in

    (* M2 *)
    out(c, (ap, sta, ga, snR, sessR, an));

    (* M3：验证 STA 的 KeyAuth *)
    in(c, (sta2R:bitstring, ap2R:bitstring, sess2R:bitstring, ctR:bitstring));
    if sta2R = sta then
    if ap2R = ap then
    if sess2R = sessR then
      let aad = (sta, ap, snR, an, sessR) in
      let kaR = adec(ctR, aad, kek) in
      if checksign(kaR, pkS) = (gsR, ga, snR, an, sta, ap, sessR) then
        event ApFinish(sta, ap, sessR);
        event ApPTK(sta, ap, sessR, ptk);

        (* M4：AP 的身份认证 + 密钥确认 *)
        let kaap = sign((ga, gsR, an, snR, ap, sta, sessR), skA) in
        let aad2 = (ap, sta, an, snR, sessR) in
        let ct2 = aead((aad2, kaap), kek) in
        out(c, (ap, sta, sessR, ct2)).

process
  new skS:bitstring;
  new skA:bitstring;
  let pkS = pk(skS) in
  let pkA = pk(skA) in
  (* 预置公钥：把“身份 <-> 公钥”的绑定作为前提 *)
  out(c, pkS);
  out(c, pkA);
  ( !sta_proc(sta, ap, skS, pkA)
    | !ap_proc(ap, sta, skA, pkS) )
