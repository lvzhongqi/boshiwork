(* =====================================================================
   FILS SK（ANA=5 + PMKSA caching）—— PMKID 链接性：**MAC 绑定缓存**版本
   这是 FILS_SK_PRIVACY.pv 的“实现忠实”对照模型。

   为什么需要它：
     FILS_SK_PRIVACY.pv 假设“AP 只按 PMKID 查缓存、不按 MAC 查”，
     因此同一 PMKID 可以服务不同 MAC，得出 G-P2=false（MAC 随机化失效）。
     但参考实现（wpa_supplicant/hostapd 2.12）的 PMKSA 查找是
     **按 (SPA, PMKID) 匹配**的：
       src/ap/pmksa_cache_auth.c:500-502
         ether_addr_equal(entry->spa, spa) && memcmp(entry->pmkid, pmkid)
       src/ap/ieee802_11.c:3039  wpa_auth_pmksa_get(hapd->wpa_auth, sta->addr, pmkid)
       src/rsn_supp/pmksa_cache.c:529-532  (aa, spa, pmkid) 三元组匹配，
       且 wpa.c:324 传入 sm->own_addr
     即：STA 换了 MAC 后，STA 自己就找不到该 PMKSA，也不会再发这个 PMKID。

   本模型的建模：
     - pmk_spa 表示“创建该 PMKSA 时使用的 STA MAC”；
     - 缓存命中分支（!sta）只能用 pmk_spa，发送 some(pmkid)；
     - 随机化分支（!sta_rand）用新 MAC，不发 PMKID（真实实现转入完整 EAP，
       不在本模型范围内，因此该分支不会产生 StaSession 事件）；
     - AP 侧也要求 macR = pmk_spa（与 pmksa_cache_auth_get 的 SPA 过滤一致）。

   预期结果（与 FILS_SK_PRIVACY.pv 对照）：
     G-P1 仍为 false：同一 MAC 的多次会话共用 PMKID（缓存语义使然）；
     G-P2 变为 true：不同 MAC 不再共用 PMKID —— “MAC 随机化失效”这一
          结论是**实现相关**的，不是标准层保证。
     机密性（gtk/probe）仍为 true，非空性查询可满足。
   ===================================================================== *)

free c:channel.

const ap:bitstring.
const g:bitstring.
const aan5:bitstring.
const seq1:bitstring.
const seq2:bitstring.
const st_ok:bitstring.
const dhgrp:bitstring.
const rsne:bitstring.
const none:bitstring.

const label_ptk:bitstring.
const label_ick:bitstring.
const label_kek:bitstring.
const label_tk:bitstring.
const label_data:bitstring.

(* 预置 PMKSA 缓存：PMK 私有，PMKID 公开，pmk_spa 是创建时绑定的 STA MAC *)
free pmk:bitstring [private].
const pmkid:bitstring.
const pmk_spa:bitstring.

(* 机密性对照探针：证明本模型没有把密钥泄露给攻击者 *)
free gtk:bitstring [private].
free probe:bitstring [private].

fun exp(bitstring,bitstring):bitstring.
equation forall x:bitstring, y:bitstring;
  exp(exp(g,x),y) = exp(exp(g,y),x).

fun hmac(bitstring,bitstring):bitstring.
fun kdf(bitstring,bitstring,bitstring):bitstring.
fun some(bitstring):bitstring.

fun aead(bitstring,bitstring):bitstring.
reduc forall a:bitstring, p:bitstring, k:bitstring;
  adec(aead((a,p),k), a, k) = p.

(* 事件：MAC、会话、PMKID *)
event StaSession(bitstring,bitstring,bitstring).
event ApSession(bitstring,bitstring,bitstring,bitstring).
event StaDone(bitstring,bitstring,bitstring).
event ApDone(bitstring,bitstring,bitstring,bitstring).

(* =====================================================================
   隐私目标查询
   ===================================================================== *)

(* G-P1：同一 PMKID 出现在两个会话 ⇒ 两个会话必须是同一个 *)
query m1:bitstring, s1:bitstring, m2:bitstring, s2:bitstring, p:bitstring;
  event(StaSession(m1,s1,p)) && event(StaSession(m2,s2,p))
  ==> s1 = s2.

(* G-P2：同一 PMKID 出现在两个会话 ⇒ 两个 MAC 必须相同（MAC 随机化有效） *)
query m1:bitstring, s1:bitstring, m2:bitstring, s2:bitstring, p:bitstring;
  event(StaSession(m1,s1,p)) && event(StaSession(m2,s2,p))
  ==> m1 = m2.

(* 对照：即使可链接，PMK/GTK/TK 仍应保密（隐私与机密性是两个维度） *)
query attacker(gtk).
query attacker(probe).

(* 非空性：缓存命中分支确实可达，避免 G-P2=true 是空验证 *)
query m:bitstring, s:bitstring, p:bitstring;
  event(StaSession(m,s,p)).

(* =====================================================================
   缓存命中分支：MAC 必须是创建 PMKSA 时的 pmk_spa
   ===================================================================== *)
let sta(dummy:bitstring) =
  let mac = pmk_spa in
  new sn:bitstring;
  new sS:bitstring;
  let gs = exp(g,sS) in
  new sess:bitstring;

  (* M1：明文携带 PMKID *)
  out(c, (mac, ap, aan5, seq1, dhgrp, gs, sn, sess, rsne,
          some(pmkid), none));

  (* M2 *)
  in(c, (apR:bitstring, macR:bitstring, aanR:bitstring, seqR:bitstring,
         stR:bitstring, dhR:bitstring, gaR:bitstring, snR:bitstring,
         sessR:bitstring, rsneR:bitstring, anR:bitstring, pidR:bitstring));
  if apR = ap then
  if macR = mac then
  if aanR = aan5 then
  if seqR = seq2 then
  if stR = st_ok then
  if dhR = dhgrp then
  if snR = sn then
  if sessR = sess then
  if rsneR = rsne then
  if pidR = some(pmkid) then

    let dhss = exp(gaR, sS) in
    (* 缓存分支：PTK 上下文含 DHss *)
    let ptk = kdf(pmk, label_ptk, (mac, ap, sn, anR, dhss)) in
    let ick = kdf(ptk, label_ick, none) in
    let kek = kdf(ptk, label_kek, none) in
    let tk  = kdf(ptk, label_tk, none) in

    let ka = hmac(ick, (sn, anR, mac, ap, gs, gaR)) in
    let aad = (mac, ap, sn, anR, sess, rsne) in
    let ct = aead((aad, ka), kek) in

    event StaSession(mac, sess, pmkid);
    out(c, (mac, ap, sess, rsne, ct));

    (* M4 *)
    in(c, (ap2R:bitstring, mac2R:bitstring, sess2R:bitstring,
           st2R:bitstring, rsne2R:bitstring, ct2R:bitstring));
    if ap2R = ap then
    if mac2R = mac then
    if sess2R = sess then
    if st2R = st_ok then
    if rsne2R = rsne then

      let aad2 = (ap, mac, anR, sn, sess, rsne) in
      let pl2 = adec(ct2R, aad2, kek) in
      let (kaAR:bitstring, gtkR:bitstring) = pl2 in
      if kaAR = hmac(ick, (anR, sn, ap, mac, gaR, gs)) then
        event StaDone(mac, ap, sess);
        out(c, aead((label_data, probe), tk)).

(* =====================================================================
   随机化分支：换 MAC ⇒ PMKSA 未命中 ⇒ 不发 PMKID
   （真实实现此时回退到完整 EAP，本模型不展开）
   ===================================================================== *)
let sta_rand(dummy:bitstring) =
  new mac:bitstring;
  new sn:bitstring;
  new sS:bitstring;
  let gs = exp(g,sS) in
  new sess:bitstring;
  out(c, (mac, ap, aan5, seq1, dhgrp, gs, sn, sess, rsne, none, none)).

(* =====================================================================
   AP：按 (SPA, PMKID) 查缓存
   ===================================================================== *)
let ap_proc(dummy:bitstring) =
  in(c, (macR:bitstring, apR:bitstring, aanR:bitstring, seqR:bitstring,
         dhR:bitstring, gsR:bitstring, snR:bitstring, sessR:bitstring,
         rsneR:bitstring, pidR:bitstring, wrR:bitstring));
  if apR = ap then
  if aanR = aan5 then
  if seqR = seq1 then
  if dhR = dhgrp then
  if macR = pmk_spa then
  if pidR = some(pmkid) then

    new an:bitstring;
    new sA:bitstring;
    let ga = exp(g,sA) in
    let dhss = exp(gsR, sA) in
    let ptk = kdf(pmk, label_ptk, (macR, ap, snR, an, dhss)) in
    let ick = kdf(ptk, label_ick, none) in
    let kek = kdf(ptk, label_kek, none) in
    let tk  = kdf(ptk, label_tk, none) in

    event ApSession(ap, macR, sessR, pmkid);
    out(c, (ap, macR, aan5, seq2, st_ok, dhgrp, ga, snR, sessR, rsneR,
            an, some(pmkid)));

    (* M3 *)
    in(c, (mac2R:bitstring, ap2R:bitstring, sess2R:bitstring,
           rsne2R:bitstring, ctR:bitstring));
    if mac2R = macR then
    if ap2R = ap then
    if sess2R = sessR then
    if rsne2R = rsneR then

      let aad = (macR, ap, snR, an, sessR, rsneR) in
      let kaR = adec(ctR, aad, kek) in
      if kaR = hmac(ick, (snR, an, macR, ap, gsR, ga)) then
        event ApDone(ap, macR, sessR, pmkid);

        let kaap = hmac(ick, (an, snR, ap, macR, ga, gsR)) in
        let aad2 = (ap, macR, an, snR, sessR, rsneR) in
        let ct2 = aead((aad2, (kaap, gtk)), kek) in
        out(c, (ap, macR, sessR, st_ok, rsneR, ct2)).

(* =====================================================================
   顶层：缓存命中（!sta）+ 随机化未命中（!sta_rand）+ AP 并发会话
   ===================================================================== *)
process
  ( !sta(none) | !sta_rand(none) | !ap_proc(none) )
