(* =====================================================================
   FILS SK / EAP-RP：WrappedData 中的 PMK SEQ 重放测试（错误：不校验 SEQ）
   与正确版相同，但 AP 会话 B 不检查 SEQ，直接接受任意 (seq, wrapped_data)。
   攻击者把旧的 (seq1, wd1) 重放给会话 B：
     - AP 用同样的 (seq1, wd1) 重新派生 PMK；
     - PMK_B = kdf(rMSK, seq1, wd1) = PMK_A -> PMK 重用。
   查询：同一 PMK 不得出现在不同会话 -> 预期 false（重用成立）。
   ===================================================================== *)

free c:channel.

const sta:bitstring.
const ap:bitstring.
const seq1:bitstring.
const seq2:bitstring.
const ok:bitstring.
const pmkid:bitstring.
const label_pmk:bitstring.

free rmsk:bitstring [private].

const sessA:bitstring.
const sessB:bitstring.

fun kdf(bitstring,bitstring,bitstring):bitstring.

event UsePMK(bitstring,bitstring).

query s1:bitstring, s2:bitstring, k:bitstring;
  event(UsePMK(s1,k)) && event(UsePMK(s2,k)) ==> s1 = s2.

query attacker(rmsk).

process
  new wd1:bitstring;

  out(c, (sta, ap, seq1, wd1));

  (* AP A：期望 seq1，接受并派生 PMK_A *)
  in(c, (staA:bitstring, apA:bitstring, seqA:bitstring, wdA:bitstring));
  if staA = sta then
  if apA = ap then
  if seqA = seq1 then
    event UsePMK(sessA, kdf(rmsk, label_pmk, (seqA, wdA)));
  out(c, ok);

  (* AP B：错误实现——不校验 SEQ，重放被接受 *)
  in(c, (staB:bitstring, apB:bitstring, seqB:bitstring, wdB:bitstring));
  if staB = sta then
  if apB = ap then
    event UsePMK(sessB, kdf(rmsk, label_pmk, (seqB, wdB)))
