(* =====================================================================
   FILS GTK rekey 重放测试（正确实现：STA 校验 KeyID/epoch）
   GTK 帧用 KEK 做 AEAD 保护（攻击者不能伪造帧内容，只能重放）。
   场景：AP 先发旧 epoch kid1，再 rekey 发 kid2；正确 STA 按 epoch 顺序
        只接受 kid1 一次、kid2 一次，重放旧帧被拒绝。
   预期：两条查询均为 true。
   ===================================================================== *)

free c:channel.
fun aead(bitstring,bitstring):bitstring.
reduc forall m:bitstring, k:bitstring; adec(aead(m,k),k) = m.

free kek:bitstring [private].
const kid1:bitstring.
const kid2:bitstring.
free gtk1:bitstring [private].
free gtk2:bitstring [private].

event ApSend(bitstring,bitstring).
event StaAccept(bitstring,bitstring).

query k:bitstring, g:bitstring;
  event(StaAccept(k,g)) ==> event(ApSend(k,g)).

query k:bitstring, g:bitstring;
  inj-event(StaAccept(k,g)) ==> inj-event(ApSend(k,g)).

process
  out(c, aead((kid1,gtk1), kek));
  event ApSend(kid1, gtk1);

  out(c, aead((kid2,gtk2), kek));
  event ApSend(kid2, gtk2);

  (* 正确 STA：第一个帧必须是 kid1，第二个帧必须是 kid2（推进 epoch） *)
  in(c, ct1:bitstring);
  let (k1R:bitstring, g1R:bitstring) = adec(ct1, kek) in
  if k1R = kid1 then
    event StaAccept(k1R, g1R);

  in(c, ct2:bitstring);
  let (k2R:bitstring, g2R:bitstring) = adec(ct2, kek) in
  if k2R = kid2 then
    event StaAccept(k2R, g2R)
