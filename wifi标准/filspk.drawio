        </mxCell>
        <mxCell id="ANzJCg6MB-FmY9hBihJP-9" value="② AP 接收后处理&#xa;G 不支持 → Status 77&#xa;NIST SP 800-56A 校验 gSTA&#xa;生成 ANonce、(skAP,gAP)&#xa;DHss = scalar-op(&#xa;skAP, gSTA)" style="fillColor=#ffff88;strokeColor=#9E916F;" vertex="1" parent="1">
