# personal
my_work_space/
my_base_config.yaml
# skills/ are project assets and get reviewed with the code; the rest of .claude
# stays personal config. Note the syntax: once a parent directory is ignored, a
# subpath cannot be rescued with !, so we exclude the contents, not the directory.
.claude/*
!.claude/skills/
222.json
333.md
results
# But results/ under the test fixtures is a repo asset. A bare `results` matches
# any directory of that name anywhere in the tree, which also swallowed
# toy_protocol's reference output; on a fresh clone test_libschema then failed
# with FileNotFoundError (observed 2026-08-18). Same syntax note as the .claude
# entry above: subpaths cannot be rescued once the parent is ignored, so rescue
# the directory itself first, then its contents.
!tests/fixtures/toy_protocol/results/
!tests/fixtures/toy_protocol/results/*
a_work_space/
a_runs/

# `orrery prompt` renders every request into a prompts/ directory wherever it
# is run; regenerate it, never commit it.
/prompts/
/reproduced/

.DS_Store
**/.DS_Store

# Private config: copied from config.example.yaml on first launch, holds API
# keys, never committed.
/config.yaml
/experiments/config.yaml

# The dumps a failed cassette lookup leaves for diffing; the cassette itself is
# committed.

# One-shot baseline runs: model replies, .pv files and ProVerif logs, same as a_runs
experiments/oneshot/runs/

# Local backup of the server experiment data (pulled in full before the lab
# move on 2026-08-26). Never committed.
a_experiments/
# Where the batch runner writes by default (experiments/config.example.yaml).
a_batches/

# Local machine paths and experiment environment; never committed.
CLAUDE.local.md
AGENTS.local.md
# The published artifact's own layout: source, corpus, recorded runs.
runs/
VerdictBench/
a_experiments_open/
a_experiments_3/
# The Zenodo upload payload: every run behind the paper's tables, packed by
# release/usenix/. Tens of MB of results; it is published as a dataset, not
# committed here.
/orrery_experiments_results.tar.gz

# docker/compose.yaml run from inside the checkout
docker/orrery-work/
